GLOBAL_SETTINGS
    LAB_MASTER_SEED devops-waf-crs_ptit_seed
    GRADE_CONTAINER client
    HOST_HOME_XFER seed_dir/

NETWORK WAF_NET
    MASK 172.38.0.0/24
    GATEWAY 172.38.0.101

CONTAINER client
    USER ubuntu
    TERMINALS 1
    X11 YES
    WAF_NET 172.38.0.10
    ADD-HOST waf:172.38.0.20
    ADD-HOST webapp:172.38.0.30
    WAIT_FOR waf
    WAIT_FOR webapp
    SCRIPT NONE

CONTAINER waf
    USER ubuntu
    TERMINALS 1
    WAF_NET 172.38.0.20
    ADD-HOST client:172.38.0.10
    ADD-HOST webapp:172.38.0.30
    WAIT_FOR webapp
    SCRIPT NONE

CONTAINER webapp
    USER ubuntu
    TERMINALS -1
    WAF_NET 172.38.0.30
    ADD-HOST client:172.38.0.10
    ADD-HOST waf:172.38.0.20
    SCRIPT NONE
