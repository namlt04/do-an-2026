recon_rbac = matchany : string_start : recon_result : answer=OK
loot_secrets = matchany : string_start : loot_result : answer=OK
escape_node = matchany : string_equal : flag_result : parameter.k8sflag
harden_cluster = matchany : string_start : harden_result : answer=OK
lab_complete = boolean : (recon_rbac and loot_secrets and escape_node and harden_cluster)
