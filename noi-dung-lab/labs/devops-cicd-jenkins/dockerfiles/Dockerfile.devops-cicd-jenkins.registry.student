ARG registry
FROM $registry/labtainer.network2
ARG lab
ARG labdir
ARG imagedir
ARG user_name
ARG password
ARG apt_source
ARG version
LABEL version=$version
ENV APT_SOURCE $apt_source
RUN /usr/bin/apt-source.sh
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates apache2-utils python3 \
    && rm -rf /var/lib/apt/lists/*
# Docker Registry v2 (distribution) real binary - downloaded at build time, runs offline.
RUN curl -fsSL -o /tmp/registry.tgz \
        https://github.com/distribution/distribution/releases/download/v2.8.3/registry_2.8.3_linux_amd64.tar.gz \
    && tar -xzf /tmp/registry.tgz -C /usr/local/bin registry \
    && chmod +x /usr/local/bin/registry && rm -f /tmp/registry.tgz \
    && mkdir -p /var/lib/registry /auth
ADD $labdir/$imagedir/sys_tar/sys.tar /
ADD $labdir/sys_$lab.tar.gz /
RUN useradd -ms /bin/bash $user_name && echo "$user_name:$password" | chpasswd && adduser $user_name sudo
USER $user_name
ENV HOME /home/$user_name
ADD $labdir/$imagedir/home_tar/home.tar $HOME
RUN rm -f $HOME/home.tar
ADD $labdir/$lab.tar.gz $HOME
USER root
CMD ["/bin/bash", "-c", "exec /sbin/init --log-target=journal 3>&1"]
