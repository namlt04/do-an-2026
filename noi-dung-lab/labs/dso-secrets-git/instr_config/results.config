
r_recon_ok      = dev:.local/result/pregrade_summary.txt : 1 : REGEX : RECON=OK
r_gitleaks_ok   = dev:.local/result/pregrade_summary.txt : 1 : REGEX : GITLEAKS=OK
r_creds_ok      = dev:.local/result/pregrade_summary.txt : 1 : REGEX : CREDS=OK
r_loot_storage  = dev:loot_storage.txt : 1 : REGEX : .+
r_loot_api      = dev:loot_api.txt : 1 : REGEX : .+
r_loot_rotate   = dev:loot_rotate.txt : 1 : REGEX : .+
r_oldkey_denied = dev:rotate_verify.log : 1 : REGEX : RESULT=DENIED
r_gitignore_env = dev:repo/.gitignore : 1 : REGEX : \.env
r_hook_ok       = dev:.local/result/pregrade_summary.txt : 1 : REGEX : HOOK=OK
r_hook_blocked  = dev:precommit_test.log : 1 : REGEX : RESULT=COMMIT_BLOCKED
