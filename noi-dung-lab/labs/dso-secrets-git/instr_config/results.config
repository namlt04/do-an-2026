# results.config — dso-secrets-git
# ----------------------------------------------------------------------------
# Cu phap tham khao LAB-BUILD-RULES.md #5 (bai lab nay khong co san mot
# results.config That da dien de doi chieu truc tiep trong repo — xem
# BUILD-NOTES.md "Rui ro #1: cu phap results.config/goals.config" — can doi
# chieu voi 1 lab mau that (telnetlab/nmap-ssh/capabilities) tren VM truoc
# khi rebuild lan dau):
#   name = <container>:<file> : <field> : <OP> : <value>   (OP: STARTSWITH / CONTAINS / HAVESTRING / TOKEN)
#   name = <container>:.bash_history : COMMAND_COUNT : <cmd>
#   name = <container>:<file>                                 (toan bo noi dung, so sanh o goals.config)
#
# GRADE_CONTAINER = dev (bien duy nhat sinh vien co shell) => moi artifact deu
# doc tu dev. pregrade.sh (chay truoc khi cham) doi chieu bang chung THAT (git
# history, gitleaks.json, hook executable...) va ghi tom tat vao
# .local/result/pregrade_summary.txt de cac dong duoi day tham chieu — tranh
# viec chi tin loi sinh vien tu khai (chong bypass, xem LAB-BUILD-RULES #4.4).

# ---- Nhiem vu 1: recon_history ----
# pregrade.sh da doi chieu ADD_COMMIT/REMOVE_COMMIT (do sinh vien ghi trong
# ~/recon_answers.txt) voi git log THAT cua ~/repo.
r_recon_ok = dev:.local/result/pregrade_summary.txt : content : CONTAINS : RECON=OK

# ---- Nhiem vu 2: scan_secrets ----
# gitleaks.json ton tai va co >=3 finding (pregrade.sh dem so RuleID).
r_gitleaks_ok = dev:.local/result/pregrade_summary.txt : content : CONTAINS : GITLEAKS=OK
# ~/secrets_found.txt (4 dong AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY/
# DB_PASSWORD/API_TOKEN) khop CHINH XAC voi credential that (pregrade.sh so
# sanh voi hang so noi bo, khong lo cho sinh vien).
r_creds_ok = dev:.local/result/pregrade_summary.txt : content : CONTAINS : CREDS=OK

# ---- Nhiem vu 3: exploit_get_flag ----
# Toan bo noi dung file (chi 1 dong = flag lay duoc) — so sanh string_equal
# voi parameter.storageflag / parameter.apiflag o goals.config.
r_loot_storage = dev:loot_storage.txt
r_loot_api     = dev:loot_api.txt

# ---- Nhiem vu 4: remediation_harden ----
# Rotate-proof (flag thu 3), do rotate_secrets.sh TU GHI sau khi goi thanh
# cong /admin/rotate tren app (khong phai sinh vien tu go).
r_loot_rotate = dev:loot_rotate.txt

# Sau rotate, thu lai AWS key CU tren storage phai bi tu choi. Sinh vien ghi
# ket qua chuan hoa "RESULT=DENIED" / "RESULT=ALLOWED" vao ~/rotate_verify.log
# (xem huong dan Nhiem vu 4 - Buoc 1) thay vi dua vao ma thoat $? tho.
r_oldkey_denied = dev:rotate_verify.log : content : CONTAINS : RESULT=DENIED

# .gitignore phai chan file .env
r_gitignore_env = dev:repo/.gitignore : content : CONTAINS : .env

# Pre-commit hook (goi gitleaks) phai ton tai + thuc thi + khop noi dung mong doi
r_hook_ok = dev:.local/result/pregrade_summary.txt : content : CONTAINS : HOOK=OK

# Commit thu nghiem chua secret gia phai bi hook chan (marker chuan hoa)
r_hook_blocked = dev:precommit_test.log : content : CONTAINS : RESULT=COMMIT_BLOCKED
