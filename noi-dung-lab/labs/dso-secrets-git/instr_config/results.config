
r_recon_ok      = dev:.local/result/pregrade_summary.txt : CONTAINS : RECON=OK
r_gitleaks_ok   = dev:.local/result/pregrade_summary.txt : CONTAINS : GITLEAKS=OK
r_creds_ok      = dev:.local/result/pregrade_summary.txt : CONTAINS : CREDS=OK
r_loot_storage  = dev:loot_storage.txt : 1 : REGEX : .+
r_loot_api      = dev:loot_api.txt : 1 : REGEX : .+
r_loot_rotate   = dev:loot_rotate.txt : 1 : REGEX : .+
r_oldkey_denied = dev:rotate_verify.log : CONTAINS : RESULT=DENIED
r_gitignore_env = dev:repo/.gitignore : CONTAINS : .env
r_hook_ok       = dev:.local/result/pregrade_summary.txt : CONTAINS : HOOK=OK
r_hook_blocked  = dev:precommit_test.log : CONTAINS : RESULT=COMMIT_BLOCKED
