#DOC: recon Git history for secrets
g_recon_history = value : _recon_ok

#DOC: scan repository and extract secrets
g_scan_secrets = boolean : (_gitleaks_ok and _creds_ok)

_flag_storage = matchany : string_equal : r_loot_storage : parameter.storageflag
_flag_api     = matchany : string_equal : r_loot_api : parameter.apiflag

#DOC: exploit leaked secrets for flag
g_exploit_get_flag = boolean : (_flag_storage or _flag_api)

_rotate_proof     = matchany : string_equal : r_loot_rotate : parameter.rotateflag
_harden_rotate    = boolean : (_oldkey_denied and _rotate_proof)
_harden_shiftleft = boolean : (_gitignore_env and _hook_ok and _hook_blocked)

#DOC: remediate - rotate credentials, gitignore and pre-commit hook
g_remediation_harden = boolean : (_harden_rotate and _harden_shiftleft)
