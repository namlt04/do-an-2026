#DOC: recon Git history for secrets
g_recon_history = value : r_recon_ok

#DOC: scan repository and extract secrets
g_scan_secrets = boolean : (r_gitleaks_ok and r_creds_ok)

#DOC: get flag from MinIO storage
g_flag_storage = matchany : string_equal : r_loot_storage : parameter.storageflag

#DOC: get flag from HTTP API
g_flag_api = matchany : string_equal : r_loot_api : parameter.apiflag

#DOC: exploit leaked secrets for flag
g_exploit_get_flag = boolean : (g_flag_storage or g_flag_api)

#DOC: rotate leaked credentials
g_rotate_proof  = matchany : string_equal : r_loot_rotate : parameter.rotateflag
g_harden_rotate = boolean : (r_oldkey_denied and g_rotate_proof)

#DOC: shift-left with gitignore and hook
g_harden_shiftleft = boolean : (r_gitignore_env and r_hook_ok and r_hook_blocked)

#DOC: complete remediation hardening
g_remediation_harden = boolean : (g_harden_rotate and g_harden_shiftleft)
