# goals.config - dso-secrets-git
# ----------------------------------------------------------------------------
# Cu phap tham khao LAB-BUILD-RULES.md #5 (xem canh bao cu phap trong
# results.config / BUILD-NOTES.md "Rui ro #1"):
#   g = matchany : string_equal : <result> : parameter.<flag>
#   g = matchany : string_start : <result> : answer=<prefix>
#   g = boolean  : (_a and _b)   /   (_a or _b)
#   g = value    : <result>
#
# 4 Nhiem vu trong de bai deu co >=1 goal do duoc. Nhom hardening (Nhiem vu 4)
# gom 4/9 goal - dam bao ty le bao mat theo LAB-BUILD-RULES #5 (60/40).
# ----------------------------------------------------------------------------

#DOC: Nhiem vu 1 - recon_history
#SUM: Sinh vien xac dinh dung commit THEM va commit XOA file cau hinh nhay
#     cam trong lich su Git (~/recon_answers.txt), doi chieu THAT voi git log
#     boi pregrade.sh - khong chi tin loi tu khai cua sinh vien.
g_recon_history = value : r_recon_ok

#DOC: Nhiem vu 2 - scan_secrets
#SUM: Ton tai bao cao ~/gitleaks.json voi >=3 finding, VA sinh vien trich
#     xuat dung ca 4 gia tri credential (AWS access key, AWS secret key, DB
#     password, API token) vao ~/secrets_found.txt.
g_scan_secrets = boolean : (r_gitleaks_ok and r_creds_ok)

#DOC: Nhiem vu 3 - exploit_get_flag (huong A: MinIO storage)
#SUM: Dung cap AWS key gia dao duoc de xac thuc MinIO va doc object flag
#     rieng cho tung sinh vien.
g_flag_storage = matchany : string_equal : r_loot_storage : parameter.storageflag

#DOC: Nhiem vu 3 - exploit_get_flag (huong B: HTTP API app)
#SUM: Dung API token (hoac DB password qua Basic Auth) dao duoc de xac thuc
#     API /flag va lay flag rieng cho tung sinh vien.
g_flag_api = matchany : string_equal : r_loot_api : parameter.apiflag

#DOC: Nhiem vu 3 - tong hop
#SUM: De bai yeu cau hoan thanh >=1 huong khai thac (khuyen nghi ca hai).
g_exploit_get_flag = boolean : (g_flag_storage or g_flag_api)

#DOC: Nhiem vu 4 - remediation_harden (Buoc 1: rotate)
#SUM: rotate_secrets.sh da chay thanh cong (rotate-proof / flag thu 3 khop
#     dung, chi co duoc qua goi API /admin/rotate that), VA AWS key gia CU
#     tren storage bi tu choi (AccessDenied) ngay sau khi rotate.
g_rotate_proof  = matchany : string_equal : r_loot_rotate : parameter.rotateflag
g_harden_rotate = boolean : (r_oldkey_denied and g_rotate_proof)

#DOC: Nhiem vu 4 - remediation_harden (Buoc 3-5: shift-left)
#SUM: .gitignore chan file .env/*.env, VA pre-commit hook (goi gitleaks
#     protect --staged) ton tai + thuc thi + chan thanh cong 1 commit thu
#     nghiem chua secret gia (ghi nhan RESULT=COMMIT_BLOCKED).
g_harden_shiftleft = boolean : (r_gitignore_env and r_hook_ok and r_hook_blocked)

#DOC: Nhiem vu 4 - tong hop
g_remediation_harden = boolean : (g_harden_rotate and g_harden_shiftleft)
