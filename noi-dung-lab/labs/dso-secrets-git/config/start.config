
GLOBAL_SETTINGS

	LAB_MASTER_SEED dso-secrets-git_ptit_seed

	GRADE_CONTAINER dev

NETWORK SECGIT_NET
	MASK 172.32.0.0/24
	GATEWAY 172.32.0.101

CONTAINER dev
	USER ubuntu
	TERMINALS 1
	SECGIT_NET 172.32.0.10
	ADD-HOST app:172.32.0.20
	ADD-HOST storage:172.32.0.30

CONTAINER app
	USER ubuntu
	TERMINALS -1
	SECGIT_NET 172.32.0.20
	ADD-HOST dev:172.32.0.10
	ADD-HOST storage:172.32.0.30
	SCRIPT NONE
	WAIT_FOR storage

CONTAINER storage
	USER ubuntu
	TERMINALS -1
	SECGIT_NET 172.32.0.30
	ADD-HOST dev:172.32.0.10
	ADD-HOST app:172.32.0.20
	SCRIPT NONE
