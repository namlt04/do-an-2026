# Filename : start.config
# Lab      : dso-secrets-git  (SecLab PTIT / DevSecOps 2026)
#
# Sinh vien khai thac secret bi lo trong lich su Git de truy cap dich vu
# muc tieu va lay flag, sau do khac phuc (rotate + shift-left).
#
# So do:
#   dev     172.32.0.10  (client - sinh vien thao tac, git/gitleaks/trufflehog/mc/curl/jq)
#   app     172.32.0.20  (HTTP API - Flask, cong 8080, TERMINALS -1)
#   storage 172.32.0.30  (MinIO S3, cong 9000, TERMINALS -1)

GLOBAL_SETTINGS

	# Master seed rieng cho bai lab -> ket hop email sinh vien -> flag per-student
	LAB_MASTER_SEED dso-secrets-git_ptit_seed

	# Container gom artifact chinh va chay pregrade
	GRADE_CONTAINER dev

# ---------------------------------------------------------------------------
# Mang ao rieng cho bai lab
# ---------------------------------------------------------------------------
NETWORK SECGIT_NET
	MASK 172.32.0.0/24
	GATEWAY 172.32.0.101

# ---------------------------------------------------------------------------
# Container: dev  (may cua sinh vien)
# ---------------------------------------------------------------------------
CONTAINER dev
	USER ubuntu
	TERMINALS 1
	SECGIT_NET 172.32.0.10
	ADD-HOST app:172.32.0.20
	ADD-HOST storage:172.32.0.30
	# Cho phep phan giai ten dich vu tren mang (tuy chon, sinh vien van co the dung IP)

# ---------------------------------------------------------------------------
# Container: app  (HTTP API muc tieu - khong cho sinh vien shell)
# ---------------------------------------------------------------------------
CONTAINER app
	USER ubuntu
	TERMINALS -1
	SECGIT_NET 172.32.0.20
	ADD-HOST dev:172.32.0.10
	ADD-HOST storage:172.32.0.30
	# Image chay /sbin/init (systemd) => SCRIPT phai la NONE
	SCRIPT NONE
	# app dieu phoi rotate qua MinIO admin API tren storage -> doi storage
	# hoan tat parameterization + fixlocal truoc khi app tu khoi dong.
	WAIT_FOR storage

# ---------------------------------------------------------------------------
# Container: storage  (MinIO object store muc tieu - khong cho sinh vien shell)
# ---------------------------------------------------------------------------
CONTAINER storage
	USER ubuntu
	TERMINALS -1
	SECGIT_NET 172.32.0.30
	ADD-HOST dev:172.32.0.10
	ADD-HOST app:172.32.0.20
	SCRIPT NONE
