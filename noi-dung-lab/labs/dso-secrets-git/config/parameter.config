# parameter.config
#
# Sinh flag per-student bang HASH_REPLACE.
#   Cu phap: <param> : HASH_REPLACE : <container>:<file>[;<container>:<file>] : <TOKEN> : <seed_string> [: <len>]
#
# Framework thay literal <TOKEN> trong file (tren container DICH VU) bang mot
# gia tri hash duy nhat cho tung sinh vien (dua tren LAB_MASTER_SEED + email SV).
# Gia tri hash duoc tham chieu trong goals.config qua parameter.<param>.
#
# LUU Y CHONG BYPASS:
#   - Cac file chua TOKEN nam tren 'app' va 'storage' (sinh vien KHONG co shell).
#   - Sinh vien chi lay duoc flag khi thuc su dung credential dao tu Git history
#     de xac thuc vao dich vu -> khong the cat/grep/.bash_history ra flag.
#   - Credential (AWS key gia / DB pass / API token) la TINH, nhung flag la
#     per-student => khong the copy giua sinh vien.

# Flag 1: nam trong object cua bucket private tren MinIO (storage).
storageflag : HASH_REPLACE : storage:/home/ubuntu/flag_object.txt : RUNFLAGSTORAGE : dso_secrets_git_storage_object : 20

# Flag 2: tra ve sau khi xac thuc thanh cong vao HTTP API (app).
apiflag : HASH_REPLACE : app:/home/ubuntu/flag_api.txt : RUNFLAGAPI : dso_secrets_git_api_auth : 20

# Flag 3 (remediation): chung minh da rotate credential - app chi tra "proof"
# nay sau khi rotate thanh cong (vo hieu key cu). Dung cho goal harden_rotate.
rotateflag : HASH_REPLACE : app:/home/ubuntu/flag_rotate.txt : RUNFLAGROTATE : dso_secrets_git_rotate_proof : 20
