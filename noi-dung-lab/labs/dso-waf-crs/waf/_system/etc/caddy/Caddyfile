{
	admin off
	auto_https off
	order coraza_waf first
}

:80 {
	# /flag2,/flag3: bypass the WAF, forwarded straight to the issuer service on webapp.
	@flags path /flag2 /flag3
	handle @flags {
		reverse_proxy webapp:8099
	}
	# All remaining traffic passes through the Coraza WAF then to the vulnerable webapp.
	handle {
		coraza_waf {
			include /etc/coraza/main.conf
		}
		reverse_proxy webapp:8080
	}
}
