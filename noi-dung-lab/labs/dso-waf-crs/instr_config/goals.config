#DOC: Task 1 exploit_direct - exploit the webapp directly (path traversal) to get Flag 1
exploit_direct = matchany : string_equal : flag1_result : parameter.flag1

#DOC: Task 2 deploy_waf - enable Coraza blocking, attacks return 403, get Flag 2
deploy_waf = matchany : string_equal : flag2_result : parameter.flag2

#DOC: Task 3 dast_compare - run DAST before/after WAF, warnings drop through WAF
dast_compare = matchany : string_start : dast_result : answer=OK

#DOC: Task 4 tune_falsepositive - scoped exclusion, valid function 200 + attack 403, get Flag 3
tune_falsepositive = matchany : string_equal : flag3_result : parameter.flag3

lab_complete = boolean : (exploit_direct and deploy_waf and dast_compare and tune_falsepositive)
