[Unit]
Description=Forward /var/run/docker.sock to host-sim's dockerd (devops-docker-escape)
Documentation=none
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=-/bin/rm -f /var/run/docker.sock
# INTENTIONAL: mode=666 (socket readable/writable by any user) deliberately simulates the
# "exposed Docker socket" misconfiguration this lab teaches students to spot and exploit.
ExecStart=/usr/bin/socat UNIX-LISTEN:/var/run/docker.sock,fork,reuseaddr,mode=666 TCP:172.35.0.5:2375
Restart=always
RestartSec=2
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
