#
# Labtainer Dockerfile - cloud-s3-misconfig : storage (dich vu object storage "cloud")
#
# MinIO server (tuong thich API S3), cong 9000 (API) / 9001 (console, khong dung
# trong bai). Binary minio + mc tai luc BUILD (VM co internet) -> runtime OFFLINE.
# Dich vu duoc quan ly boi systemd (unit tai _system/etc/systemd/system/minio.service),
# du lieu (bucket/policy/user/flag) duoc seed trong _bin/fixlocal.sh SAU khi
# parameterization hoan tat (xem config/parameter.config).
#
ARG registry
FROM $registry/labtainer.network
#FROM $registry/labtainer.base2
#FROM $registry/labtainer.centos
#FROM $registry/labtainer.lamp
#
#  lab is the fully qualified image name, e.g., mylab.some_container.student
#  labdir is the name of the lab, e.g., mylab
#  imagedir is the name of the container
#  user_name is the USER from the start.config, if other than ubuntu,
#            then that user must be added in this dockerfile
#            before the USER command
#
ARG lab
ARG labdir
ARG imagedir
ARG user_name
ARG password
ARG apt_source
ARG version
LABEL version=$version
ENV APT_SOURCE $apt_source
RUN /usr/bin/apt-source.sh
#
#  put package installation here, e.g.,
#     RUN apt-get update && apt-get install -y --no-install-recommends somepackage
#
#  ---- MinIO server + mc (cai luc build) ----
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl jq tar gzip && \
    rm -rf /var/lib/apt/lists/*
# MinIO khong con tai duoc (dl.min.io 410 Gone; Docker Hub minio/minio+minio/mc = 404).
# minio + mc la binary BUILD-TU-NGUON (go install, static CGO_ENABLED=0), duoc NHET
# vao image qua sys_tar/sys.tar -> /usr/local/bin/{minio,mc}. Xem labs/_shared/bin/
# va buoc inject-binaries khi deploy (PROGRESS.md).
#
#
# Install the system files found in the _system directory (bao gom
# etc/systemd/system/minio.service)
#
ADD $labdir/$imagedir/sys_tar/sys.tar /
ADD $labdir/sys_$lab.tar.gz /
#
RUN useradd -ms /bin/bash $user_name
RUN echo "$user_name:$password" | chpasswd
RUN adduser $user_name sudo
# replace above with below for centos/fedora
#RUN usermod $user_name -a -G wheel

# Thu muc du lieu MinIO - thuoc so huu user cua container de systemd (User=ubuntu
# trong minio.service) co the ghi duoc
RUN mkdir -p /data/minio && chown -R $user_name:$user_name /data/minio

#
#  **** Perform all root operations, e.g.,           ****
#  **** "apt-get install" prior to the USER command. ****
#
USER $user_name
ENV HOME /home/$user_name
#
# Install files in the user home directory
#
ADD $labdir/$imagedir/home_tar/home.tar $HOME
# remove after docker fixes problem with empty tars
RUN rm -f $HOME/home.tar
ADD $labdir/$lab.tar.gz $HOME
#
#  The first thing that executes on the container.
#
USER root
CMD ["/bin/bash", "-c", "exec /sbin/init --log-target=journal 3>&1"]
