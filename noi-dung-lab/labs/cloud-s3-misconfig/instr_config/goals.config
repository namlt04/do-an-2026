# goals.config - cloud-s3-misconfig
#
# Cu phap tham khao LAB-BUILD-RULES.md section 5 va Labtainer Lab Designer Guide section 6.3:
#   g = matchany : string_equal : <result> : <parameter.X | literal>
#   g = boolean  : (_a and _b)
# Quy uoc dat ten: bien phu tro dung de gop trong "boolean" dat ten voi dau "_"
# o dau (khong bao cao rieng); ten KHONG co "_" o dau la goal chinh thuc, dat
# theo ten nhiem vu (enum_*, exfiltrate_*, access_*, harden_*) - theo dung
# LAB-BUILD-RULES.md section 5 ("Ten goal dat theo ten nhiem vu").
#
# GHI CHU KIEM CHUNG (truoc khi rebuild that - xem BUILD-NOTES.md):
#   Doi chieu cu phap khai bao goal (co can tu khoa "GOAL"/ky hieu dac biet nao
#   khac o dau dong hay khong) voi vi du that trong labs/telnetlab,
#   labs/nmap-ssh, labs/capabilities tren may build, roi dieu chinh neu can.
#
# CHONG BYPASS: KHONG co goal nao chi kiem tra "file ton tai" hay dung
# COMMAND_COUNT don thuan - moi goal nhay cam (NV2/NV3) so sanh GIA TRI THAT
# (parameter.<x>, sinh tu HASH_REPLACE rieng cho tung SV) va moi goal hardening
# (NV4) so sanh KET QUA THAT tu MinIO (DENIED/ENABLED do script cua SV tu grep
# ra tu response that, khong phai chuoi SV go tay).

#DOC: NV1 (enum_anonymous) - da liet ke duoc noi dung bucket public-assets O CHE
#DOC: DO AN DANH (khong dung credential) VA doc duoc bucket policy public
#DOC: (Principal "*", cho phep s3:GetObject/s3:ListBucket).
# MinIO that KHONG cho doc bucket-policy AN DANH (get-bucket-policy -> AccessDenied),
# nen bang chung misconfig = LIET KE AN DANH thanh cong (khong can credential).
enum_anonymous = matchany : string_equal : recon_list_status : answer=LISTED

#DOC: NV2 (exfiltrate_backup) - da tai duoc file backup tu bucket public VA
#DOC: trich xuat DUNG cap access_key/secret_key bi lo (gia tri phai khop tuyet
#DOC: doi voi credential rieng cua tung sinh vien).
_leak_access      = matchany : string_equal : creds_access_raw : parameter.leak_access_key
_leak_secret      = matchany : string_equal : creds_secret_raw : parameter.leak_secret_key
exfiltrate_backup = boolean : (_leak_access and _leak_secret)

#DOC: NV3 (access_secure_bucket) - da dung DUNG credential bi lo de xac thuc va
#DOC: lay DUNG gia tri flag tu object trong bucket private secure-data (khop
#DOC: parameter.s3flag rieng cua tung sinh vien).
access_secure_bucket = matchany : string_equal : loot_flag_raw : parameter.s3flag

#DOC: NV4a (harden_storage) - anonymous access tren public-assets DA BI CHAN
#DOC: (lenh liet ke an danh sau khi sua tra ve loi AccessDenied THAT SU tu MinIO,
#DOC: khong phai SV tu go chuoi).
harden_public_denied = matchany : string_equal : harden_anon_status : answer=DENIED

#DOC: NV4b (harden_storage) - da bat versioning cho bucket secure-data (trang
#DOC: thai Status=Enabled xac nhan THAT SU tu MinIO qua get-bucket-versioning).
harden_versioning_enabled = matchany : string_equal : harden_versioning_status : answer=ENABLED
