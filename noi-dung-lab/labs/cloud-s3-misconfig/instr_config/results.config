# results.config — cloud-s3-misconfig
#
# Grammar (kiem chung tu ResultParser.py + lab mau telnetlab/onewayhash/sshlab):
#   <name> = <container>:<file> : <field> : <LINE_TYPE> : <match>
#   - field  = chi so TOKEN (tach theo khoang trang), bat dau tu 1
#   - LINE_TYPE = LINE (chon dong theo so), STARTSWITH, HAVESTRING, CONTAINS...
#   - Voi file 1-dong 1-token: "<file> : 1 : LINE : 1" -> token dau tien cua dong 1.
#
# CHONG BYPASS: cac result nhay cam (creds/flag) so GIA TRI THAT voi parameter.<x>
# (sinh tu HASH_REPLACE rieng tung SV) trong goals.config; khong goal nao chi
# kiem tra "file ton tai".

# --- NV1 enum_anonymous: liet ke an danh thanh cong (SV ghi 'LISTED') ---
recon_list_status        = client:recon_list_status.txt : 1 : LINE : 1

# --- NV2 exfiltrate_backup: cap credential SV trich tu backup ---
creds_access_raw         = client:creds_access_key.txt : 1 : LINE : 1
creds_secret_raw         = client:creds_secret_key.txt : 1 : LINE : 1

# --- NV3 access_secure_bucket: flag SV lay tu bucket private ---
loot_flag_raw            = client:loot.txt : 1 : LINE : 1

# --- NV4 harden_storage: ket qua kiem tra hau-hardening (SV ghi DENIED/ENABLED) ---
harden_anon_status       = client:harden_anon_status.txt : 1 : LINE : 1
harden_versioning_status = client:harden_versioning_status.txt : 1 : LINE : 1
