# results.config - cloud-s3-misconfig
#
# Grammar: <name> = <container>:<file> : <field_token_idx> : <LINE_TYPE> : <match>
#   Dung REGEX ".+" de chon dong dau tien khong rong, lay token 1.
#   (LUU Y: line_type "LINE" bi bug trong ResultParser cua Labtainer nay -
#    bien lineno khong dinh nghia - nen KHONG dung; dung REGEX/STARTSWITH.)
#   File 1-dong 1-token -> ": 1 : REGEX : .+".
#
# CHONG BYPASS: result nhay cam so GIA TRI THAT voi parameter.<x> (HASH_REPLACE)
# trong goals.config.

recon_list_status        = client:recon_list_status.txt : 1 : REGEX : .+
creds_access_raw         = client:creds_access_key.txt : 1 : REGEX : .+
creds_secret_raw         = client:creds_secret_key.txt : 1 : REGEX : .+
loot_flag_raw            = client:loot.txt : 1 : REGEX : .+
harden_anon_status       = client:harden_anon_status.txt : 1 : REGEX : .+
harden_versioning_status = client:harden_versioning_status.txt : 1 : REGEX : .+
