# parameter.config — cloud-s3-misconfig
#
# Cu phap: <param> : HASH_REPLACE : <container>:<file>[;<container>:<file>] : <TOKEN> : <seed_string> [: <len>]
#
# Framework thay literal <TOKEN> trong (cac) file tren container DICH VU (va, khi
# can, ca tren client) bang MOT gia tri hash duy nhat cho tung sinh vien (tinh tu
# LAB_MASTER_SEED = cloud-s3-misconfig_ptit_seed + email SV + seed_string rieng).
# Gia tri hash duoc tham chieu trong instr_config/goals.config qua parameter.<param>.
#
# LUU Y CHONG BYPASS (xem LAB-BUILD-RULES.md §4):
#   - leak_access_key/leak_secret_key: dat trong storage:/home/ubuntu/seed/*.token,
#     la credential SE BI "LO" qua backup trong bucket public. Storage/_bin/fixlocal.sh
#     doc gia tri DA duoc thay the nay de tao that mot MinIO user tuong ung, roi moi
#     nhung vao noi dung backup. SV KHONG co shell tren storage nen khong the
#     cat/doc truc tiep — chi lay duoc bang cach khai thac dung chuoi (anonymous
#     list/get -> tai backup -> grep credential).
#   - s3flag: dat trong storage:/home/ubuntu/seed/flag.token, la object flag trong
#     bucket private secure-data — chi tai duoc SAU KHI xac thuc bang dung cap
#     credential bi lo o tren (MinIO tu choi neu sai key/secret).
#   - harden_access_key/harden_secret_key: dat DONG THOI tren client (SV DUOC CAP
#     CONG KHAI qua ~/hardening-admin.env de lam Nhiem vu 4) va tren storage (de
#     fixlocal.sh tao dung MinIO user tuong ung voi quyen sua bucket policy/
#     versioning). Day KHONG PHAI credential bi lo — la credential duoc phat cho
#     SV, moi SV mot cap khac nhau de khong the chia se lenh nguyen van cho nhau.

# --- Credential se bi "lo" qua backup trong bucket public (Nhiem vu 2) ---
leak_access_key : HASH_REPLACE : storage:/home/ubuntu/seed/leaked_access_key.token : LEAKACCESSKEY : cloud-s3-misconfig_ptit_seed_leakaccess : 16
leak_secret_key : HASH_REPLACE : storage:/home/ubuntu/seed/leaked_secret_key.token : LEAKSECRETKEY : cloud-s3-misconfig_ptit_seed_leaksecret : 32

# --- Flag trong object cua bucket private secure-data (Nhiem vu 3) ---
s3flag : HASH_REPLACE : storage:/home/ubuntu/seed/flag.token : RUNFLAG : cloud-s3-misconfig_ptit_seed_flag : 24

# --- Credential hardening duoc cap cong khai cho SV dung o Nhiem vu 4 ---
harden_access_key : HASH_REPLACE : client:/home/ubuntu/hardening-admin.env;storage:/home/ubuntu/seed/harden_access_key.token : HARDENACCESSKEY : cloud-s3-misconfig_ptit_seed_hardenaccess : 16
harden_secret_key : HASH_REPLACE : client:/home/ubuntu/hardening-admin.env;storage:/home/ubuntu/seed/harden_secret_key.token : HARDENSECRETKEY : cloud-s3-misconfig_ptit_seed_hardensecret : 32
