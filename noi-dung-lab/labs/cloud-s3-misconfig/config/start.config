# Filename : start.config
# Lab      : cloud-s3-misconfig (SecLab PTIT / Cloud Security 2026)
#
# Sinh vien (attacker) khai thac bucket S3 (MinIO) bi cau hinh sai tren storage:
# liet ke an danh -> tai backup -> lo credential -> dung credential truy cap
# bucket private -> lay flag -> (DevSecOps) hardening lai object storage.
#
# So do:
#   client   172.33.0.10  (may tan cong cua sinh vien: aws-cli/mc/curl/jq, TERMINALS 1, GRADE_CONTAINER)
#   storage  172.33.0.30  (MinIO - S3-compatible object storage, cong API 9000, TERMINALS -1)

GLOBAL_SETTINGS

	# GRADE_CONTAINER - noi gom artifact chinh va chay pregrade
	GRADE_CONTAINER client

	# LAB_MASTER_SEED - chuoi seed rieng cho bai nay; ket hop email SV -> flag/credential ca nhan hoa
	LAB_MASTER_SEED cloud-s3-misconfig_ptit_seed

	# Uncomment and change to match your registry (if not labtainers)
	#REGISTRY your_registry
	#BASE_REGISTRY your_registry

# ---------------------------------------------------------------------------
# Mang ao rieng cua bai lab
# ---------------------------------------------------------------------------
NETWORK LAB_NET
	MASK 172.33.0.0/24
	GATEWAY 172.33.0.101

# ---------------------------------------------------------------------------
# Container: client (may cua sinh vien - dong vai attacker roi DevSecOps engineer)
# ---------------------------------------------------------------------------
CONTAINER client
	USER ubuntu
	TERMINALS 1
	LAB_NET 172.33.0.10
	# Cho phep phan giai ten "storage" tren mang (tuy chon, SV van co the dung IP truc tiep)
	ADD-HOST storage:172.33.0.30 -- LAB_NET
	# Doi storage khoi tao + seed xong MinIO (bucket/policy/credential) truoc khi
	# client mo terminal, de dam bao endpoint san sang ngay khi SV bat dau
	WAIT_FOR storage

# ---------------------------------------------------------------------------
# Container: storage (dich vu object storage "cloud" - MinIO) - khong cho SV shell
# ---------------------------------------------------------------------------
CONTAINER storage
	USER ubuntu
	TERMINALS -1
	LAB_NET 172.33.0.30
	# Container chay /sbin/init that (systemd quan ly dich vu minio.service)
	SCRIPT NONE
