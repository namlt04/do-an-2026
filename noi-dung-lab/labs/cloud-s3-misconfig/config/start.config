GLOBAL_SETTINGS

	GRADE_CONTAINER client

	LAB_MASTER_SEED cloud-s3-misconfig_ptit_seed

NETWORK S3_NET
	MASK 172.33.0.0/24
	GATEWAY 172.33.0.101

CONTAINER client
	USER ubuntu
	TERMINALS 1
	S3_NET 172.33.0.10
	ADD-HOST storage:172.33.0.30
	WAIT_FOR storage

CONTAINER storage
	USER ubuntu
	TERMINALS -1
	S3_NET 172.33.0.30
	ADD-HOST client:172.33.0.10
	SCRIPT NONE
