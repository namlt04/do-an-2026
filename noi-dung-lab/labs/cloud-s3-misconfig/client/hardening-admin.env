#   export AWS_ACCESS_KEY_ID=$(grep '^AWS_ACCESS_KEY_ID=' hardening-admin.env | cut -d= -f2)
#   export AWS_SECRET_ACCESS_KEY=$(grep '^AWS_SECRET_ACCESS_KEY=' hardening-admin.env | cut -d= -f2)
