# Filename : start.config
# Lab      : dso-iac-scan  (Bao mat IaC / shift-left scanning cho Terraform)
#
# Hai container:
#   devsecops (172.31.0.10) - ban lam viec cua ky su, co terminal (TERMINALS 1),
#                             la GRADE_CONTAINER, chua ~/iac-project + bo cong cu quet.
#   ci        (172.31.0.20) - dich vu "quality gate", KHONG co shell (TERMINALS -1),
#                             giu flag va tu chay tfsec de dem HIGH/CRITICAL.

GLOBAL_SETTINGS

	# GRADE_CONTAINER - noi gom artifact chinh va chay pregrade
	GRADE_CONTAINER devsecops

	# HOST_HOME_XFER - deprecated nhung giu theo mau template
	HOST_HOME_XFER seed_dir/

	# LAB_MASTER_SEED - chuoi seed rieng cho bai nay; ket hop email SV -> flag ca nhan hoa
	LAB_MASTER_SEED dso-iac-scan_ptit_seed

	# Uncomment and change to match your registry (if not labtainers)
	#REGISTRY your_registry
	#BASE_REGISTRY your_registry

	# Thu artifact tren toan bo container deu duoc gom khi cham diem.

# Mang rieng cua bai: 172.31.0.0/24, gateway .101
NETWORK IAC_NET
	MASK 172.31.0.0/24
	GATEWAY 172.31.0.101

# Container sinh vien thao tac
CONTAINER devsecops
	USER ubuntu
	TERMINALS 1
	IAC_NET 172.31.0.10
	ADD-HOST ci:172.31.0.20

# Container dich vu CI (khong cho SV shell), giu flag
CONTAINER ci
	USER ubuntu
	TERMINALS -1
	IAC_NET 172.31.0.20
	ADD-HOST devsecops:172.31.0.10
