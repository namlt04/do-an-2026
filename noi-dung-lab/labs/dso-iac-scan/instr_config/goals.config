#DOC: Baseline IaC scan completed
baseline_scan = matchany : string_equal : chk_baseline : answer=OK

#DOC: Fix network and storage misconfigurations
fix_network_storage = matchany : string_equal : chk_network_storage : answer=OK

#DOC: Remove secrets and apply least-privilege IAM
fix_secret_iam = matchany : string_equal : chk_secret_iam : answer=OK

#DOC: Enable logging and pass CI gate
_after_zero_ok = matchany : string_equal : chk_after_zero : answer=OK
_logging_ok    = matchany : string_equal : chk_logging : answer=OK
_flag_ok       = matchany : string_equal : flag_submitted : parameter.iacflag
pass_gate      = boolean : (_after_zero_ok and _logging_ok and _flag_ok)
