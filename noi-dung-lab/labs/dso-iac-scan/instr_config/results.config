# results.config -- dso-iac-scan
#
# Container GRADE_CONTAINER la `devsecops`. Cac dong duoi day bien artifact
# thu duoc tu container do thanh cac "result" de goals.config so sanh.
#
# Chien luoc chong bypass: thay vi tin truc tiep noi dung baseline.json/
# after.json (sinh vien co the echo/sua tay vi co shell + sudo tren
# devsecops), phan lon cac "result" duoi day la CAC FILE DANH DAU (chk_*)
# duoc TAO LAI boi instr_config/pregrade.sh bang cach tu phan tich lai
# ~/iac-project/*.tf va cac bao cao JSON thu duoc -- khong phai do sinh vien
# tu ghi. Rieng flag (flag_submitted) chi co the dung neu sinh vien thuc su
# vuot qua duoc dich vu `ci` (container khong co shell, tu quet doc lap).
#
# Cu phap: name = <container>:<file>   (lay toan bo noi dung file)

# --- Nhiem vu 1: baseline_scan ---
chk_baseline         = devsecops:.local/result/chk_baseline

# --- Nhiem vu 2: fix_network_storage (hardening) ---
chk_network_storage  = devsecops:.local/result/chk_network_storage

# --- Nhiem vu 3: fix_secret_iam (hardening) ---
chk_secret_iam       = devsecops:.local/result/chk_secret_iam

# --- Nhiem vu 4: pass_gate ---
chk_after_zero       = devsecops:.local/result/chk_after_zero
chk_logging           = devsecops:.local/result/chk_logging
flag_submitted        = devsecops:flag.txt
