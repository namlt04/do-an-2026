# results.config - dso-iac-scan
#
# Grammar: <name> = <container>:<file> : <field_token_idx> : <LINE_TYPE> : <match>
#   Dung REGEX ".+" chon dong dau khong rong, lay token 1.
#   (KHONG dung "LINE" - bi bug (lineno undefined) trong ResultParser Labtainer nay.)
#   - chk_* : pregrade.sh ghi "OK"/"FAIL"
#   - flag.txt : flag SV lay tu CI gate (container ci, SV khong co shell)
#
# CHONG BYPASS: flag so GIA TRI THAT voi parameter.iacflag (HASH_REPLACE rieng SV);
# chk_* do pregrade tu phan tich lai ma Terraform that.

chk_baseline         = devsecops:.local/result/chk_baseline : 1 : REGEX : .+
chk_network_storage  = devsecops:.local/result/chk_network_storage : 1 : REGEX : .+
chk_secret_iam       = devsecops:.local/result/chk_secret_iam : 1 : REGEX : .+
chk_after_zero       = devsecops:.local/result/chk_after_zero : 1 : REGEX : .+
chk_logging          = devsecops:.local/result/chk_logging : 1 : REGEX : .+
flag_submitted       = devsecops:flag.txt : 1 : REGEX : .+
