GLOBAL_SETTINGS

	GRADE_CONTAINER devops

	HOST_HOME_XFER seed_dir/

	LAB_MASTER_SEED devops-iac-scan_ptit_seed

NETWORK IAC_NET
	MASK 172.31.0.0/24
	GATEWAY 172.31.0.101

CONTAINER devops
	USER ubuntu
	TERMINALS 1
	IAC_NET 172.31.0.10
	ADD-HOST ci:172.31.0.20

CONTAINER ci
	USER ubuntu
	TERMINALS -1
	IAC_NET 172.31.0.20
	ADD-HOST devops:172.31.0.10
