#DOC: Inspect the Docker image layer history
inspect_layers = matchany : string_start : layers_result : answer=OK

#DOC: Extract the secret left behind in a layer
extract_secret = matchany : string_start : secret_result : answer=OK

#DOC: Scan the image for CVEs with Trivy (offline)
scan_cves = matchany : string_start : cve_result : answer=OK

#DOC: Use the leaked key to get the flag from vault-svc
get_flag = matchany : string_equal : flag_result : parameter.imageflag

#DOC: Harden the image (multi-stage build, non-root user, .dockerignore)
harden_image = matchany : string_start : harden_result : answer=OK
