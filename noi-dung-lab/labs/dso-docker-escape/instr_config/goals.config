# goals.config - dso-docker-escape
#
# Ty le 60/40: 4/5 nhiem vu la khai thac (trinh sat + 2 duong escape + doc flag),
# 1/5 nhiem vu la hardening (bat buoc, khong tinh nhiem vu 3 tuy chon).

#DOC: recon_container -- Nhiem vu 1: sinh vien phat hien >=1 dau hieu cau hinh sai
#DOC: (docker.sock lo / CAP_SYS_ADMIN / block device host) va ghi lai vao ~/recon.txt
recon_container = matchany : string_start : recon_ok : answer=OK

#DOC: escape_via_socket -- Nhiem vu 2: sinh vien dung docker.sock bi lo tren app de
#DOC: dieu khien dockerd that cua host-sim, tao container moi mount rootfs host va
#DOC: doc duoc canary /root/.hostmarker (luu vao ~/host_evidence.txt); ket hop voi
#DOC: bang chung mot lenh docker thuc su (khong phai echo gia) trong bash history.
_escape_marker_match = matchany : string_equal : hostmarker_result : parameter.hostmarker
_escape_cmd_evidence = matchany : string_start : escape_cmd_ok : answer=OK
escape_via_socket = boolean : (_escape_marker_match and _escape_cmd_evidence)

#DOC: escape_via_privileged (TUY CHON / KHONG BAT BUOC) -- Nhiem vu 3: sinh vien tim
#DOC: hieu duong thoat thay the qua --privileged/CAP_SYS_ADMIN/nsenter. Danh gia LENIENT
#DOC: qua chinh bang chung trinh sat (Nhiem vu 1) vi ket qua thuc te phu thuoc cau hinh
#DOC: lop Docker cua VM Labtainer (xem BUILD-NOTES.md) - KHONG bat buoc de hoan thanh bai.
escape_via_privileged = matchany : string_start : recon_ok : answer=OK

#DOC: get_flag -- Nhiem vu 4: sinh vien doc duoc /root/flag.txt tren host-sim (chi co
#DOC: the sau khi escape thanh cong) va luu dung dinh dang vao ~/flag_result.txt
get_flag = matchany : string_equal : flag_result : parameter.dockerflag

#DOC: harden_container -- Nhiem vu 5 (HARDENING, bat buoc): sinh vien viet lai cau hinh
#DOC: `docker run` an toan (khong --privileged, khong mount docker.sock, co
#DOC: --cap-drop=ALL) vao ~/hardened_run.sh va anh xa CIS Docker Benchmark vao
#DOC: ~/hardening_map.txt
harden_container = matchany : string_start : harden_ok : answer=OK

#DOC: lab_complete -- Tong hop: hoan thanh toan bo cac nhiem vu BAT BUOC cua bai
#DOC: (khong tinh Nhiem vu 3 tuy chon)
lab_complete = boolean : (recon_container and escape_via_socket and get_flag and harden_container)
