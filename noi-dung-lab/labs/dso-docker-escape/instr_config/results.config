# results.config - dso-docker-escape
# REGEX ".+" trích token1 (KHÔNG dùng LINE — bug framework).
# CHONG BYPASS: flag + hostmarker so parameter.* (HASH_REPLACE, nằm trên host-sim,
# SV không có shell) -> chỉ đọc được sau khi escape thật.
recon_ok          = app:.local/result/recon_ok.txt : 1 : REGEX : .+
hostmarker_result = app:host_evidence.txt : 1 : REGEX : .+
escape_cmd_ok     = app:.local/result/escape_cmd_ok.txt : 1 : REGEX : .+
flag_result       = app:flag_result.txt : 1 : REGEX : .+
harden_ok         = app:.local/result/harden_ok.txt : 1 : REGEX : .+
