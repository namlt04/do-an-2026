# results.config - dso-docker-escape
#
# Artifact thu tu container `app` ($HOME cua sinh vien, day cung la GRADE_CONTAINER).
# Cac ket qua "*_ok" (recon_ok, escape_cmd_ok, harden_ok) duoc pregrade.sh TINH SAN va
# ghi vao .local/result/ truoc khi cham - tranh phai bieu dien logic AND/NOT phuc tap
# ngay trong goals.config va giup pregrade.sh kiem tra "bang chung khai thac that" (vd
# lenh docker that trong bash history) thay vi chi kiem tra file co ton tai hay khong.

# ---- Nhiem vu 1: recon_container ----
# "OK" neu ~/recon.txt co it nhat 1 trong 3 dau hieu cau hinh sai (xem pregrade.sh)
recon_ok = app:.local/result/recon_ok.txt

# ---- Nhiem vu 2: escape_via_socket ----
# Noi dung ~/host_evidence.txt (canary doc duoc tu host-sim qua docker.sock)
hostmarker_result = app:host_evidence.txt
# "OK" neu bash_history co lenh `docker ... -H ... run ... -v /: ...` that su duoc go
escape_cmd_ok = app:.local/result/escape_cmd_ok.txt

# ---- Nhiem vu 4: get_flag ----
# Noi dung ~/flag_result.txt (flag doc duoc tu host-sim qua docker.sock)
flag_result = app:flag_result.txt

# ---- Nhiem vu 5: harden_container ----
# "OK" neu ~/hardened_run.sh KHONG --privileged, KHONG mount docker.sock, CO
# --cap-drop=ALL, VA ~/hardening_map.txt ton tai + khong rong (xem pregrade.sh)
harden_ok = app:.local/result/harden_ok.txt
