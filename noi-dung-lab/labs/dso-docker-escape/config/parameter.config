# parameter.config
#
# FLAG + CANARY per-student cho bai dso-docker-escape.
#
# - dockerflag : gia tri FLAG chinh. Nam trong host-sim:/root/flag.txt, dinh dang
#                PTIT{...}. Sinh vien KHONG co shell tren host-sim nen chi doc duoc
#                sau khi thoat container (escape) thanh cong qua docker.sock (hoac
#                duong tuy chon privileged/nsenter). Goal "get_flag" so parameter.dockerflag.
#
# - hostmarker : canary RIENG (tach biet voi flag), nam trong host-sim:/root/.hostmarker.
#                Dung de goal "escape_via_socket" co bang chung do luong rieng cho buoc
#                escape (doc lap voi buoc doc flag o Nhiem vu 4), chong viec sinh vien
#                "doan" hoac chia se flag ma khong thuc su khai thac. Ca hai gia tri deu
#                la HASH_REPLACE nen khac nhau giua tung sinh vien (khong the copy cheo).
#
# Co che parameterize: literal TOKEN duoc dat san trong file tren container host-sim
# (xem host-sim/_system/root/flag.txt va host-sim/_system/root/.hostmarker). Luc
# parameterize (truoc khi fixlocal.sh chay), framework thay TOKEN bang hash per-student
# sinh tu LAB_MASTER_SEED + email sinh vien + seed_string rieng cua tung param.
#
# Cu phap: <param> : HASH_REPLACE : <container>:<file> : <TOKEN> : <seed_string> [: <len>]

dockerflag : HASH_REPLACE : host-sim:/root/flag.txt : DOCKERESCFLAG : dso_docker_escape_flag_seed : 16

hostmarker : HASH_REPLACE : host-sim:/root/.hostmarker : HOSTMARKERTOKEN : dso_docker_escape_marker_seed : 20
