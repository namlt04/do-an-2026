GLOBAL_SETTINGS

	LAB_MASTER_SEED dso-docker-escape_ptit_seed

	GRADE_CONTAINER app

	HOST_HOME_XFER seed_dir/

NETWORK ESCAPE_NET
	MASK 172.35.0.0/24
	GATEWAY 172.35.0.101

CONTAINER app
	USER ubuntu
	TERMINALS 1
	ESCAPE_NET 172.35.0.10
	ADD-HOST host-sim:172.35.0.5
	WAIT_FOR host-sim
	SCRIPT NONE
	NO_PRIVILEGE YES

CONTAINER host-sim
	USER ubuntu
	TERMINALS -1
	ESCAPE_NET 172.35.0.5
	ADD-HOST app:172.35.0.10
	SCRIPT NONE
