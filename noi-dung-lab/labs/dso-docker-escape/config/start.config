# Filename : start.config
# Lab      : dso-docker-escape  (Container Escape / MITRE ATT&CK T1611 - SecLab PTIT)
#
# Hai container:
#   app       (172.35.0.10) - noi sinh vien co shell (TERMINALS 1). Bi cau hinh YEU
#                              co chu dich: /var/run/docker.sock tren app duoc forward
#                              (qua socat) toi dockerd that su dang chay tren host-sim.
#                              KHONG can chay privileged o lop VM de khai thac duoc
#                              duong chinh (docker.sock) -> dat NO_PRIVILEGE YES cho an
#                              toan/on dinh khi trien khai (xem BUILD-NOTES.md).
#   host-sim  (172.35.0.5)  - MO PHONG "may host" chay Docker Engine that (dind).
#                              KHONG co shell cho sinh vien (TERMINALS -1). Giu
#                              /root/flag.txt + canary /root/.hostmarker. Container nay
#                              GIU nguyen che do privileged mac dinh cua Labtainer vi
#                              dockerd/dind can no.

GLOBAL_SETTINGS

	# LAB_MASTER_SEED - chuoi seed rieng cho bai nay; ket hop email SV -> flag ca nhan hoa
	LAB_MASTER_SEED dso-docker-escape_ptit_seed

	# GRADE_CONTAINER - noi gom artifact chinh (~/recon.txt, ~/host_evidence.txt,
	# ~/flag_result.txt, ~/hardened_run.sh, ~/hardening_map.txt) va chay pregrade
	GRADE_CONTAINER app

	# HOST_HOME_XFER - giu theo mau template cua cac bai khac trong bo lab nay
	HOST_HOME_XFER seed_dir/

	# Uncomment and change to match your registry (if not labtainers)
	#REGISTRY your_registry
	#BASE_REGISTRY your_registry

# ---------------------------------------------------------------------------
# Mang ao rieng cho bai lab: 172.35.0.0/24, gateway .101 (ESCAPE_NET)
# ---------------------------------------------------------------------------
NETWORK ESCAPE_NET
	MASK 172.35.0.0/24
	GATEWAY 172.35.0.101

# ---------------------------------------------------------------------------
# Container: app  (may cua sinh vien - "container bi chiem")
# ---------------------------------------------------------------------------
CONTAINER app
	USER ubuntu
	TERMINALS 1
	ESCAPE_NET 172.35.0.10
	ADD-HOST host-sim:172.35.0.5
	# Cho phep dung ten "host-sim" thay vi go IP tay (sinh vien van co the dung IP)
	# Doi host-sim khoi dong xong dockerd + build image "escimg" truoc khi app tu forward
	WAIT_FOR host-sim
	# Image chay /sbin/init (systemd) => SCRIPT phai la NONE
	SCRIPT NONE
	# Duong khai thac CHINH (docker.sock qua socat) KHONG can container app o che do
	# privileged cua lop Docker/VM ben duoi. Tat privileged cho app de giam rui ro
	# trien khai va thu hep be mat tan cong khong can thiet (least privilege cho may
	# "attacker"). Xem BUILD-NOTES.md muc "Quyet dinh NO_PRIVILEGE".
	NO_PRIVILEGE YES

# ---------------------------------------------------------------------------
# Container: host-sim  (MO PHONG may host chay Docker Engine that - khong cho SV shell)
# ---------------------------------------------------------------------------
CONTAINER host-sim
	USER ubuntu
	TERMINALS -1
	ESCAPE_NET 172.35.0.5
	ADD-HOST app:172.35.0.10
	SCRIPT NONE
	# KHONG dat NO_PRIVILEGE o day: host-sim GIU che do privileged mac dinh cua
	# Labtainer vi dockerd/docker-in-docker (dind) can quyen nay de chay that.
