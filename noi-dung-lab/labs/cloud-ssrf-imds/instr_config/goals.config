#DOC: SSRF discovery against internal targets
g_discover_ssrf = value : _discover_ssrf

#DOC: steal IAM credentials via SSRF
g_steal_credentials = boolean : (_steal_ssrf_path and _loot_accesskey)

#DOC: access storage and retrieve flag
g_access_storage_get_flag = matchany : string_equal : r_loot_flag : parameter.ctf_flag

#DOC: harden SSRF and enforce IMDSv2
g_harden_ssrf_imds = boolean : (_harden_blocks and _imdsv2_enforced and _remediation_ok)
