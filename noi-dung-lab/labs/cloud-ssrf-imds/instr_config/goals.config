# goals.config - cloud-ssrf-imds
#
# 4 goal chinh (1 / nhiem vu). g_harden_ssrf_imds la goal hardening (bat
# buoc >=1 theo LAB-BUILD-RULES.md muc 5). Cac goal phu (a, b, c, d, e)
# la buoc trung gian duoc to hop bang boolean (_x and _y).

#DOC: Nhiem vu 1 - discover_ssrf: sinh vien chung minh chuc nang "fetch URL"
#     cua webapp bi ep goi toi dia chi noi bo (loopback cua webapp va/hoac
#     IMDS gia) - bang chung lay tu fetch.log tren web (sinh vien khong co
#     shell tren web nen khong the gia mao).
#SUM: PASS khi co it nhat 1 request duoc webapp THUC SU thuc hien (allowed)
#     toi mot dich noi bo/nhay cam.
g_discover_ssrf = value : r_discover_ssrf

#DOC: Nhiem vu 2 - steal_credentials: sinh vien dung SSRF de doc duong dan
#     /latest/meta-data/iam/security-credentials/<role> tren IMDS gia va
#     trich xuat duoc AccessKeyId/SecretAccessKey/Token.
#SUM: PASS khi (a) fetch.log tren web cho thay request security-credentials
#     DUOC THUC HIEN THAT qua SSRF, VA (b) sinh vien luu duoc JSON credential
#     (co truong AccessKeyId) vao ~/creds.txt tren client.
a = value : r_steal_ssrf_path
b = value : r_loot_accesskey
g_steal_credentials = boolean : (_a and _b)

#DOC: Nhiem vu 3 - access_storage_get_flag: sinh vien dung credential tam
#     thoi danh cap de xac thuc (AWS SigV4 that qua aws-cli) vao MinIO va
#     tai flag.txt tu bucket private "fin-reports".
#SUM: PASS khi noi dung ~/loot.txt tren client TRUNG KHOP CHINH XAC voi flag
#     per-student (parameter.ctf_flag) - chi co the co duoc bang cach xac
#     thuc thanh cong vao storage, khong the doan/gia mao.
g_access_storage_get_flag = matchany : string_equal : r_loot_flag : parameter.ctf_flag

#DOC: Nhiem vu 4 - harden_ssrf_imds (HARDENING): sinh vien ap dung allowlist
#     chong SSRF tren webapp (POST /admin/harden) VA bat IMDSv2 tren imds
#     (POST /admin/enable-imdsv2, xac nhan ca chan GET tran lan van cho phep
#     luong hop le), VA ghi lai remediation.txt du 3 lop phong thu (allowlist,
#     IMDSv2, least privilege).
#SUM: PASS khi CA BA dieu kien tren deu co bang chung: (c) webapp thuc su
#     chan mot request toi IMDS sau khi bat allowlist, (d) imds thuc su tu
#     choi GET tran (401) NHUNG van chap nhan luong token hop le (chung
#     minh IMDSv2 hoat dong dung, khong phai loi/hong dich vu), (e)
#     remediation.txt du tu khoa.
c = value : r_harden_blocks
d = value : r_imdsv2_enforced
e = value : r_remediation_ok
g_harden_ssrf_imds = boolean : (_c and _d and _e)
