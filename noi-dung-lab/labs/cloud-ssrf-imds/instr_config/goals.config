# goals.config - cloud-ssrf-imds
# boolean tham chieu TRUC TIEP result (CONTAINS, kieu boolean) - khong dung goal
# trung gian kieu "value" (khong AND duoc). g_harden_ssrf_imds la goal hardening.
# CHONG BYPASS: g_access_storage_get_flag so loot.txt == parameter.ctf_flag
# (HASH_REPLACE per-student, flag tren storage). Cac result khac do pregrade suy
# tu artifact that (fetch.log web, imds_access.log imds).

#DOC: NV1 discover_ssrf - webapp thuc su fetch toi dich noi bo/IMDS
g_discover_ssrf = value : r_discover_ssrf

#DOC: NV2 steal_credentials - SSRF doc security-credentials + luu JSON credential
g_steal_credentials = boolean : (r_steal_ssrf_path and r_loot_accesskey)

#DOC: NV3 access_storage_get_flag - dung credential danh cap lay dung flag per-student
g_access_storage_get_flag = matchany : string_equal : r_loot_flag : parameter.ctf_flag

#DOC: NV4 harden_ssrf_imds (HARDENING) - chan SSRF + IMDSv2 + remediation.txt
g_harden_ssrf_imds = boolean : (r_harden_blocks and r_imdsv2_enforced and r_remediation_ok)
