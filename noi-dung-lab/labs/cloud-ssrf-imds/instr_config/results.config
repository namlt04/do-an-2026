# results.config - cloud-ssrf-imds
#
# Dang "toan noi dung": name = <container>:<file>
# (xem LAB-BUILD-RULES.md muc 5). Phan lon result o day doc truc tiep cac
# file bang chung ".ok" ma instr_config/pregrade.sh da suy ra tu artifact
# tho (fetch.log tren web, imds_access.log tren imds, remediation.txt/
# creds.txt tren client) - cac file nay chi chua "YES" khi dieu kien thuc
# su xay ra, rong/khong ton tai neu chua lam. r_loot_flag la ngoai le: doc
# nguyen ~/loot.txt tren client de so khop CHINH XAC voi parameter.ctf_flag.

# --- Nhiem vu 1 (discover_ssrf) --------------------------------------------
r_discover_ssrf   = web:.local/result/discover_ssrf.ok

# --- Nhiem vu 2 (steal_credentials) ----------------------------------------
r_steal_ssrf_path = web:.local/result/steal_via_ssrf.ok
r_loot_accesskey  = client:.local/result/loot_accesskey.ok

# --- Nhiem vu 3 (access_storage_get_flag) -----------------------------------
r_loot_flag       = client:loot.txt

# --- Nhiem vu 4 (harden_ssrf_imds) ------------------------------------------
r_harden_blocks   = web:.local/result/harden_blocks_ssrf.ok
r_imdsv2_enforced = imds:.local/result/imdsv2_enforced.ok
r_remediation_ok  = client:.local/result/remediation_ok.ok
