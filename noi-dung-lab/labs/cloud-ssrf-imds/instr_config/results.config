# results.config - cloud-ssrf-imds
#
# Grammar: CONTAINS (boolean "file chua chuoi") cho cac co .ok (pregrade ghi "YES");
#   REGEX ".+" de trich flag so voi parameter. (KHONG dung LINE - bug framework.)
#
# CHONG BYPASS: loot so GIA TRI THAT voi parameter.ctf_flag (HASH_REPLACE, flag
# nam tren storage). Cac .ok do pregrade suy ra tu artifact that (fetch.log cua
# web, imds_access.log cua imds - SV khong co shell tren cac container do).

r_discover_ssrf   = web:.local/result/discover_ssrf.ok : CONTAINS : YES
r_steal_ssrf_path = web:.local/result/steal_via_ssrf.ok : CONTAINS : YES
r_loot_accesskey  = client:.local/result/loot_accesskey.ok : CONTAINS : YES
r_loot_flag       = client:loot.txt : 1 : REGEX : .+
r_harden_blocks   = web:.local/result/harden_blocks_ssrf.ok : CONTAINS : YES
r_imdsv2_enforced = imds:.local/result/imdsv2_enforced.ok : CONTAINS : YES
r_remediation_ok  = client:.local/result/remediation_ok.ok : CONTAINS : YES
