# parameter.config
#
# Sinh flag + credential IMDS gia PER-STUDENT bang HASH_REPLACE.
#   Cu phap: <param> : HASH_REPLACE : <container>:<file>[;<container>:<file>] : <TOKEN> : <seed_string> [: <len>]
#
# Framework thay literal <TOKEN> trong (cac) file dich (tren container DICH VU,
# sinh vien KHONG co shell) bang mot gia tri hash duy nhat cho tung sinh vien,
# sinh tu LAB_MASTER_SEED + email sinh vien + seed_string cua tham so. Gia tri
# hash duoc tham chieu trong instr_config/goals.config qua parameter.<param>.
#
# LUU Y CHONG BYPASS:
#   - Cac file chua TOKEN nam tren 'imds' va 'storage' (TERMINALS -1, sinh vien
#     KHONG co shell) -> khong the cat/echo gia flag/credential.
#   - AccessKeyId va SecretAccessKey duoc bom CUNG MOT GIA TRI HASH vao ca 2
#     container (imds va storage) bang cu phap da-dich (<container>:<file>;
#     <container>:<file>) => credential "tam thoi" ma imds tra ve LUON KHOP
#     voi credential goc (MINIO_ROOT_USER/PASSWORD) ma storage (MinIO) chap
#     nhan de xac thuc SigV4 that. Khong co duong nao khac de doan/gia mao.
#   - Flag nam trong object private tren bucket MinIO; MinIO tu choi moi
#     request khong ky (unsigned) hoac ky sai -> sinh vien BAT BUOC phai co
#     dung AccessKeyId/SecretAccessKey lay tu imds (qua SSRF) moi doc duoc.
#   - web (webapp) chi lam proxy "fetch ho" (khong tu ky request S3) nen
#     KHONG the dung SSRF de bo qua imds ma lay thang du lieu object co y
#     nghia tren storage.

# --- AccessKeyId gia (giong nhau tren imds va storage) ---------------------
imds_access_key : HASH_REPLACE : imds:/home/ubuntu/imds_app/creds_template.json;storage:/home/ubuntu/minio_env.sh : RUNKEYID : cloud-ssrf-imds_ptit_seed_akid : 12

# --- SecretAccessKey gia (giong nhau tren imds va storage) -----------------
imds_secret_key : HASH_REPLACE : imds:/home/ubuntu/imds_app/creds_template.json;storage:/home/ubuntu/minio_env.sh : RUNSECRETKEY : cloud-ssrf-imds_ptit_seed_secret : 28

# --- SessionToken gia (chi mang tinh hinh thuc, chi can co tren imds) ------
imds_session_token : HASH_REPLACE : imds:/home/ubuntu/imds_app/creds_template.json : RUNSESSIONTOKEN : cloud-ssrf-imds_ptit_seed_token : 24

# --- Flag: nam trong object flag.txt cua bucket private "fin-reports" ------
ctf_flag : HASH_REPLACE : storage:/home/ubuntu/flag_seed.txt : RUNFLAG : cloud-ssrf-imds_ptit_seed_flag : 16
