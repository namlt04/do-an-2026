# Filename : start.config
# Lab      : cloud-ssrf-imds  (SecLab PTIT / Cloud Security 2026)
#
# Tai hien su co Capital One 2019: ung dung web "imgproxy-portal" dinh loi
# SSRF (chuc nang "xem truoc anh theo URL") bi loi dung de ep server goi toi
# Instance Metadata Service (IMDS) gia, doc credential tam thoi cua IAM role,
# roi dung credential do truy cap cloud object storage (MinIO) de lay flag.
# Nhiem vu cuoi: hardening (allowlist chong SSRF + IMDSv2 + least privilege).
#
# So do:
#   client  172.34.0.10  (may attacker cua sinh vien: curl, jq, aws-cli v2)
#   web     172.34.0.20  (Flask "imgproxy-portal", dinh SSRF, cong 8080, TERMINALS -1)
#   imds    172.34.0.40  (Flask, gia lap Instance Metadata Service, cong 80, TERMINALS -1)
#   storage 172.34.0.30  (MinIO S3-compatible, cong 9000, TERMINALS -1)
#
# Ghi chu dia chi IMDS: dia chi that cua IMDS tren cloud la link-local
# 169.254.169.254. Trong moi truong Labtainer (Docker bridge, mang LAB_NET
# 172.34.0.0/24), khong the gan tin cay dia chi ngoai dai subnet nay lam IP
# chinh cua container. Lab dung TEN DNS NOI BO "imds" (172.34.0.40, khai bao
# qua ADD-HOST) lam duong dan CHAC CHAN hoat dong; dong thoi imds/_bin/fixlocal.sh
# co thu gan them alias 169.254.169.254 len chinh no (best-effort, khong anh
# huong toi cham diem neu that bai). Xem BUILD-NOTES.md muc "Quyet dinh dia
# chi IMDS" de biet ly do day du.

GLOBAL_SETTINGS

	# Master seed rieng cho bai lab -> ket hop email sinh vien -> flag/credential per-student
	LAB_MASTER_SEED cloud-ssrf-imds_ptit_seed

	# Container gom artifact chinh va chay pregrade
	GRADE_CONTAINER client

# ---------------------------------------------------------------------------
# Mang ao rieng cho bai lab
# ---------------------------------------------------------------------------
NETWORK LAB_NET
	MASK 172.34.0.0/24
	GATEWAY 172.34.0.101

# ---------------------------------------------------------------------------
# Container: client  (may cua sinh vien - dong vai attacker)
# ---------------------------------------------------------------------------
CONTAINER client
	USER ubuntu
	TERMINALS 1
	LAB_NET 172.34.0.10
	# Ten DNS noi bo tien loi cho sinh vien (khong bat buoc, van dung duoc IP)
	ADD-HOST web:172.34.0.20 -- LAB_NET
	ADD-HOST storage:172.34.0.30 -- LAB_NET
	ADD-HOST imds:172.34.0.40 -- LAB_NET
	# Doi web/imds/storage khoi dong xong truoc khi client san sang, tranh
	# sinh vien gap loi ket noi ngay nhung giay dau
	WAIT_FOR web
	WAIT_FOR imds
	WAIT_FOR storage

# ---------------------------------------------------------------------------
# Container: web  (imgproxy-portal - DINH SSRF - khong cho sinh vien shell)
# ---------------------------------------------------------------------------
CONTAINER web
	USER ubuntu
	TERMINALS -1
	LAB_NET 172.34.0.20
	ADD-HOST imds:172.34.0.40 -- LAB_NET
	# Image chay /sbin/init (systemd) => SCRIPT phai la NONE
	SCRIPT NONE

# ---------------------------------------------------------------------------
# Container: imds  (gia lap Instance Metadata Service - khong cho sinh vien shell)
# ---------------------------------------------------------------------------
CONTAINER imds
	USER ubuntu
	TERMINALS -1
	LAB_NET 172.34.0.40
	SCRIPT NONE

# ---------------------------------------------------------------------------
# Container: storage  (MinIO S3-compatible - khong cho sinh vien shell)
# ---------------------------------------------------------------------------
CONTAINER storage
	USER ubuntu
	TERMINALS -1
	LAB_NET 172.34.0.30
	SCRIPT NONE
