GLOBAL_SETTINGS

	LAB_MASTER_SEED cloud-ssrf-imds_ptit_seed

	GRADE_CONTAINER client

NETWORK SSRF_NET
	MASK 172.34.0.0/24
	GATEWAY 172.34.0.101

CONTAINER client
	USER ubuntu
	TERMINALS 1
	SSRF_NET 172.34.0.10
	ADD-HOST web:172.34.0.20
	ADD-HOST imds:172.34.0.40
	ADD-HOST storage:172.34.0.30
	WAIT_FOR web
	WAIT_FOR imds
	WAIT_FOR storage

CONTAINER web
	USER ubuntu
	TERMINALS -1
	SSRF_NET 172.34.0.20
	ADD-HOST client:172.34.0.10
	ADD-HOST imds:172.34.0.40
	ADD-HOST storage:172.34.0.30
	SCRIPT NONE

CONTAINER imds
	USER ubuntu
	TERMINALS -1
	SSRF_NET 172.34.0.40
	ADD-HOST client:172.34.0.10
	ADD-HOST web:172.34.0.20
	ADD-HOST storage:172.34.0.30
	SCRIPT NONE

CONTAINER storage
	USER ubuntu
	TERMINALS -1
	SSRF_NET 172.34.0.30
	ADD-HOST client:172.34.0.10
	ADD-HOST web:172.34.0.20
	ADD-HOST imds:172.34.0.40
	SCRIPT NONE
