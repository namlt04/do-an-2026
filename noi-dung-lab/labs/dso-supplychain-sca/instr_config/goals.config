generate_sbom = matchany : string_start : sbom_result : answer=OK
scan_dependencies = matchany : string_start : scan_result : answer=OK
exploit_dependency = matchany : string_equal : flag_result : parameter.scaflag
remediate_and_gate = matchany : string_start : remediate_result : answer=OK
lab_complete = boolean : (generate_sbom and scan_dependencies and exploit_dependency and remediate_and_gate)
