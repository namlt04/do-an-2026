GLOBAL_SETTINGS
    LAB_MASTER_SEED dso-supplychain-sca_ptit_seed
    GRADE_CONTAINER dev
    HOST_HOME_XFER seed_dir/

NETWORK SCA_NET
    MASK 172.37.0.0/24
    GATEWAY 172.37.0.101

CONTAINER dev
    USER ubuntu
    TERMINALS 1
    SCA_NET 172.37.0.10
    ADD-HOST appserver:172.37.0.20
    WAIT_FOR appserver
    SCRIPT NONE

CONTAINER appserver
    USER ubuntu
    TERMINALS -1
    SCA_NET 172.37.0.20
    ADD-HOST dev:172.37.0.10
    SCRIPT NONE
