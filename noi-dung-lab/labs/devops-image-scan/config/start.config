GLOBAL_SETTINGS
    LAB_MASTER_SEED devops-image-scan_ptit_seed
    GRADE_CONTAINER workstation
    HOST_HOME_XFER seed_dir/

NETWORK IMAGE_NET
    MASK 172.36.0.0/24
    GATEWAY 172.36.0.101

CONTAINER workstation
    USER ubuntu
    TERMINALS 1
    IMAGE_NET 172.36.0.10
    ADD-HOST vault-svc:172.36.0.20
    WAIT_FOR vault-svc
    SCRIPT NONE

CONTAINER vault-svc
    USER ubuntu
    TERMINALS -1
    IMAGE_NET 172.36.0.20
    ADD-HOST workstation:172.36.0.10
    SCRIPT NONE
