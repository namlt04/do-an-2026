#DOC: recon the compromised ServiceAccount RBAC permissions
recon_rbac = matchany : string_start : recon_result : answer=OK

#DOC: loot the Secret and the secret leaked in the ConfigMap
loot_secrets = matchany : string_start : loot_result : answer=OK

#DOC: escape to the node via a hostPath pod and read the host flag
escape_node = matchany : string_equal : flag_result : parameter.k8sflag

#DOC: harden the cluster with least-privilege RBAC and Pod Security
harden_cluster = matchany : string_start : harden_result : answer=OK
