GLOBAL_SETTINGS
    LAB_MASTER_SEED devops-k8s-rbac_ptit_seed
    GRADE_CONTAINER attacker
    HOST_HOME_XFER seed_dir/

NETWORK K8S_NET
    MASK 172.40.0.0/24
    GATEWAY 172.40.0.101

CONTAINER attacker
    USER ubuntu
    TERMINALS 1
    K8S_NET 172.40.0.10
    ADD-HOST k8s-node:172.40.0.20
    WAIT_FOR k8s-node
    SCRIPT NONE

CONTAINER k8s-node
    USER ubuntu
    TERMINALS -1
    K8S_NET 172.40.0.20
    ADD-HOST attacker:172.40.0.10
    SCRIPT NONE
