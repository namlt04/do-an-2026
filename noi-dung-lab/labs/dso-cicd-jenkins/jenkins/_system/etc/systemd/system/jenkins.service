[Unit]
Description=Jenkins CI (dso-cicd-jenkins)
After=network-online.target

[Service]
User=ubuntu
Environment=JENKINS_HOME=/var/jenkins_home
Environment=JAVA_OPTS=-Djenkins.install.runSetupWizard=false -Dhudson.model.UsageStatistics.disabled=true
ExecStart=/usr/bin/java -Djenkins.install.runSetupWizard=false -jar /opt/jenkins/jenkins.war --httpPort=8080
Restart=always

[Install]
WantedBy=multi-user.target
