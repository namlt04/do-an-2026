recon_jenkins = matchany : string_start : recon_result : answer=OK
rce_script_console = matchany : string_equal : flagci_result : parameter.flagci
harvest_creds = matchany : string_equal : reg_result : parameter.regpass
pivot_registry = matchany : string_equal : flagpivot_result : parameter.flagpivot
harden_jenkins = matchany : string_start : harden_result : answer=OK
lab_complete = boolean : (recon_jenkins and rce_script_console and harvest_creds and pivot_registry and harden_jenkins)
