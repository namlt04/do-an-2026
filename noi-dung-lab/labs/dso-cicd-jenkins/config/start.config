GLOBAL_SETTINGS
    LAB_MASTER_SEED dso-cicd-jenkins_ptit_seed
    GRADE_CONTAINER client
    HOST_HOME_XFER seed_dir/

NETWORK CICD_NET
    MASK 172.39.0.0/24
    GATEWAY 172.39.0.101

CONTAINER client
    USER ubuntu
    TERMINALS 1
    CICD_NET 172.39.0.30
    ADD-HOST jenkins:172.39.0.10
    ADD-HOST registry:172.39.0.20
    WAIT_FOR jenkins
    WAIT_FOR registry
    SCRIPT NONE

CONTAINER jenkins
    USER ubuntu
    TERMINALS -1
    CICD_NET 172.39.0.10
    ADD-HOST registry:172.39.0.20
    SCRIPT NONE

CONTAINER registry
    USER ubuntu
    TERMINALS -1
    CICD_NET 172.39.0.20
    ADD-HOST jenkins:172.39.0.10
    SCRIPT NONE
